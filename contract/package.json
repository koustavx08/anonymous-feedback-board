{
  "name": "@feedback/contract",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/feedback.compact ./src/managed/feedback",
    "build": "tsc --project tsconfig.json && npm run copy:managed",
    "copy:managed": "node -e \"const fs=require('fs');if(!fs.existsSync('src/managed')){console.error('src/managed missing - run npm run compact first');process.exit(1)}fs.cpSync('src/managed','dist/managed',{recursive:true});fs.copyFileSync('src/feedback.compact','dist/feedback.compact')\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
