# Copy to `.env` and fill in after you deploy the contract.
#
# Which Midnight network the wallet should connect to: undeployed | preview | preprod
VITE_NETWORK_ID=preprod

# Address printed by `npm run deploy`. Leave the placeholder until you deploy.
VITE_CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>

# Local proof server. Proving happens on your machine so private state stays there.
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
